from pathlib import Path
import json
import shutil
from datetime import datetime

import joblib


# ============================================================
# 1. PROJECT PATHS
# ============================================================

BASE_DIR = Path.cwd()

MODEL_FILE = BASE_DIR / "models" / "aqi_model.pkl"
FEATURE_FILE = BASE_DIR / "models" / "feature_columns.pkl"
METADATA_FILE = BASE_DIR / "models" / "model_metadata.json"

REGISTRY_DIR = BASE_DIR / "model_registry"

print("Base directory:", BASE_DIR)
print("Registry directory:", REGISTRY_DIR)


# ============================================================
# 2. VALIDATE EXISTING MODEL FILES
# ============================================================

if not MODEL_FILE.exists():
    raise FileNotFoundError(f"Model not found: {MODEL_FILE}")

if not FEATURE_FILE.exists():
    raise FileNotFoundError(f"Feature schema not found: {FEATURE_FILE}")

if not METADATA_FILE.exists():
    raise FileNotFoundError(f"Model metadata not found: {METADATA_FILE}")


# ============================================================
# 3. LOAD MODEL, FEATURES AND METADATA
# ============================================================

model = joblib.load(MODEL_FILE)
feature_columns = joblib.load(FEATURE_FILE)

with open(METADATA_FILE, "r", encoding="utf-8") as f:
    training_metadata = json.load(f)

print("\nModel:", type(model).__name__)
print("Feature count:", len(feature_columns))
print("Feature columns:")
print(feature_columns)


# ============================================================
# 4. CREATE MODEL REGISTRY
# ============================================================

REGISTRY_DIR.mkdir(parents=True, exist_ok=True)

VERSION = "v1"

REGISTERED_MODEL = REGISTRY_DIR / f"aqi_model_{VERSION}.pkl"
REGISTERED_METADATA = REGISTRY_DIR / f"aqi_model_{VERSION}_metadata.json"


# ============================================================
# 5. REGISTER MODEL ARTIFACT
# ============================================================

shutil.copy2(MODEL_FILE, REGISTERED_MODEL)


# ============================================================
# 6. CREATE REGISTRY METADATA
# ============================================================

registry_metadata = {
    "model_name": "Pearls AQI Predictor",
    "version": VERSION,
    "model_type": type(model).__name__,
    "registered_at": datetime.now().isoformat(timespec="seconds"),
    "artifact": REGISTERED_MODEL.name,
    "feature_count": len(feature_columns),
    "feature_columns": list(feature_columns),
    "training_metadata": training_metadata
}


with open(REGISTERED_METADATA, "w", encoding="utf-8") as f:
    json.dump(registry_metadata, f, indent=4)


print("\nModel registered successfully.")
print("Registered model:", REGISTERED_MODEL)
print("Registered metadata:", REGISTERED_METADATA)


# ============================================================
# 7. RELOAD REGISTERED MODEL FOR VERIFICATION
# ============================================================

registered_model = joblib.load(REGISTERED_MODEL)

with open(REGISTERED_METADATA, "r", encoding="utf-8") as f:
    registered_info = json.load(f)


# ============================================================
# 8. VERIFICATION
# ============================================================

print("\n" + "=" * 55)
print("MODEL REGISTRY VERIFICATION")
print("=" * 55)

print("Model version :", registered_info["version"])
print("Model type    :", registered_info["model_type"])
print("Feature count :", registered_info["feature_count"])
print("Artifact      :", registered_info["artifact"])
print("Reloaded model:", type(registered_model).__name__)


assert type(registered_model).__name__ == type(model).__name__
assert registered_info["feature_count"] == len(feature_columns)
assert list(registered_info["feature_columns"]) == list(feature_columns)


print("\nRegistry verification PASSED.")


# ============================================================
# 9. SHOW REGISTRY CONTENTS
# ============================================================

print("\nModel Registry Contents:")

for file in sorted(REGISTRY_DIR.iterdir()):
    print("-", file.name)